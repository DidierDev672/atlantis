# ==============================================================================
# Nexora API REST — Variables de Entorno Locales
# ==============================================================================

# Conexión PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nexora_db
DB_SSLMODE=disable
DB_TIMEZONE=America/Bogota

# Seguridad JWT
JWT_SECRET=nexora_super_secret_jwt_key_local_development_2026_hotel_pms

# CORS (Permitir frontend de desarrollo)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SKIP_LOCALHOST=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Semilla inicial (Bootstrap)
BOOTSTRAP_SUPERADMIN_EMAIL=soporte@nexora.com
BOOTSTRAP_SUPERADMIN_PASSWORD=SoporteNexora2026*
BOOTSTRAP_SUPERADMIN_NAME=Soporte Técnico Nexora
BOOTSTRAP_ADMIN_EMAIL=admin@hotel.com
BOOTSTRAP_ADMIN_PASSWORD=AdminHotel2026*
BOOTSTRAP_ADMIN_NAME=Administrador del Hotel
BOOTSTRAP_RECEPTION_EMAIL=recepcion@hotel.com
BOOTSTRAP_RECEPTION_PASSWORD=RecepcionHotel2026*
BOOTSTRAP_RECEPTION_NAME=Recepcionista del Hotel
BOOTSTRAP_HQ_NAME=Sede Principal Nexora
BOOTSTRAP_HQ_ADDRESS=Calle Principal 123
BOOTSTRAP_HQ_CITY=Bogotá
BOOTSTRAP_HQ_PHONE=3001234567
